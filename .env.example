# ============================================
# CreditWise - Environment Configuration
# Copy this file to .env and customize
# It is recommended to move it to the backend folder.
# ============================================

# Explanation Provider: "local" or "openai"
EXPLANATION_PROVIDER=openai

# LLM Endpoint
# For local LLM on host: http://host.docker.internal:20128/v1 (Docker) or http://localhost:20128/v1 (local)
# For OpenAI cloud: https://api.openai.com/v1
OPENAI_BASE_URL=http://host.docker.internal:20128/v1

# Model name
OPENAI_MODEL=oc/deepseek-v4-flash-free

# API Key (leave empty for local LLMs)
OPENAI_API_KEY=

# Explanation language
EXPLANATION_LANGUAGE=fa